{
  "name": "@app/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "BOUNDARY_PATH=tmp/boundary.sqlite bun server --hot",
    "dev:network": "BOUNDARY_PATH=tmp/boundary.sqlite HOST=0.0.0.0 bun server --hot",
    "typecheck": "tsc --noEmit --pretty false",
    "dev:tls": "BOUNDARY_PATH=tmp/boundary.sqlite HOST=0.0.0.0 TLS_KEY_FILE=tls/privkey.pem TLS_CERT_FILE=tls/fullchain.pem bun server --hot",
    "dev:tls:3333": "BOUNDARY_PATH=tmp/boundary.sqlite HOST=0.0.0.0 PORT=3333 TLS_KEY_FILE=tls/privkey.pem TLS_CERT_FILE=tls/fullchain.pem bun server --hot",
    "tls:issue": "bash ../../scripts/tls-issue.sh",
    "tls:issue:staging": "STAGING=1 bash ../../scripts/tls-issue.sh",
    "tls:selfsigned": "bash ../../scripts/tls-selfsigned.sh"
  },
  "dependencies": {
    "@metafor/engine": "workspace:*",
    "@metafor/pty": "workspace:*",
    "@bulk/gravity": "workspace:*",
    "@ui/components": "workspace:*",
    "@ui/elements": "workspace:*",
    "@ui/hud": "workspace:*",
    "@ui/panes": "workspace:*",
    "boundary": "workspace:*",
    "bulk": "workspace:*",
    "dark": "workspace:*"
  }
}
