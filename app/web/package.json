{
  "name": "@app/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "BOUNDARY_PATH=tmp/boundary.sqlite bun server --hot",
    "typecheck": "tsc --noEmit --pretty false",
    "dev:tls": "BOUNDARY_PATH=tmp/boundary.sqlite TLS_KEY_FILE=/home/zavx0z/metafor/app/web/tls/privkey.pem TLS_CERT_FILE=/home/zavx0z/metafor/app/web/tls/fullchain.pem bun server --hot",
    "dev:tls:3333": "BOUNDARY_PATH=tmp/boundary.sqlite PORT=3333 TLS_KEY_FILE=/home/zavx0z/metafor/app/web/tls/privkey.pem TLS_CERT_FILE=/home/zavx0z/metafor/app/web/tls/fullchain.pem bun server --hot",
    "tls:issue": "bash ../../scripts/tls-issue.sh",
    "tls:issue:staging": "STAGING=1 bash ../../scripts/tls-issue.sh",
    "tls:selfsigned": "bash ../../scripts/tls-selfsigned.sh"
  },
  "dependencies": {
    "@bulk/gravity": "workspace:*",
    "boundary": "workspace:*",
    "bulk": "workspace:*",
    "dark": "workspace:*"
  }
}
