{
  "name": "@app/space",
  "version": "0.1.0",
  "description": "metafor space — desktop WebGPU overlay",
  "author": "zavx0z",
  "private": true,
  "type": "module",
  "main": "out/main.cjs",
  "scripts": {
    "serve": "bun --hot server.ts",
    "build:web": "bun build.ts",
    "build:main": "bun build-main.ts",
    "build": "bun run build:web && bun run build:main",
    "dev": "bun electron/dev.ts",
    "start": "bun run build && electron out/main.cjs",
    "package:dir": "bun run build && electron-builder --mac dir --x64",
    "package": "bun run build && electron-builder --mac dmg --x64"
  },
  "dependencies": {
    "@metafor/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@webgpu/types": "^0.1.50",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.metafor.space",
    "productName": "space",
    "electronVersion": "33.4.11",
    "files": [
      "out/**/*",
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "identity": null,
      "extendInfo": {
        "LSUIElement": 1
      },
      "target": [
        { "target": "dmg", "arch": ["x64"] }
      ]
    },
    "asar": true
  }
}
