{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MetaFor",
  "version": "0.1.0",
  "identifier": "ru.proizvodstvo1.metafor",
  "build": {
    "devUrl": "https://meta.proizvodstvo1.ru",
    "frontendDist": "../webview"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MetaFor",
        "url": "https://meta.proizvodstvo1.ru",
        "width": 1280,
        "height": 900,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "fullscreen": true,
        "devtools": true,
        "backgroundColor": "#0b0f14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
