{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "@webgpu/types"
    ],
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "declaration": true
  },
  "extends": "../tsconfig.json",
  "include": [
    "src/**/*",
    "tests/**/*",
    "../fixture/bunWebGPU.ts"
  ],
  "exclude": [
    "docs",
    "dist",
    "dist-test"
  ]
}