{
  "name": "@cosmos/startup",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "cosmos:main": "./main/index.ts",
      "cosmos:service": "./service/index.ts",
      "cosmos:server": "./server/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "build:main": "bun build ./main/index.ts --conditions=cosmos:main --target=browser --packages=external --production --minify --drop console.debug --outfile=dist/main.js",
    "build:service": "bun build ./service/index.ts --conditions=cosmos:service --target=browser --production --minify --drop console.debug --outfile=dist/service.js",
    "build:server": "bun build ./server/index.ts --conditions=cosmos:server --target=bun --packages=external --production --minify --drop console.debug --outfile=dist/server.js"
  },
  "dependencies": {
    "@cosmos/release": "workspace:^0.1.15"
  },
  "devDependencies": {
    "@types/serviceworker": "^0.0.200"
  }
}
