{
  "name": "@hamiltonian/startup",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "hamiltonian:main": "./main/index.ts",
      "hamiltonian:service": "./service/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "build:main": "bun build ./main/index.ts --conditions=hamiltonian:main --target=browser --packages=external --production --minify --drop console.debug --outfile=dist/main.js",
    "build:service": "bun build ./service/index.ts --conditions=hamiltonian:service --target=browser --production --minify --drop console.debug --outfile=dist/service.js"
  },
  "dependencies": {
    "@hamiltonian/release": "workspace:^0.1.3"
  },
  "devDependencies": {
    "@types/serviceworker": "^0.0.200"
  }
}
