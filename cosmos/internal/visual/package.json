{
  "name": "@internal/visual",
  "version": "0.1.14",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "internal:main": "./main/index.ts",
      "internal:server": "./server/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "build:main": "bun build ./main/index.ts --conditions=internal:main --target=browser --production --minify --drop console.debug --outfile=dist/main.js",
    "build:server": "bun build ./server/index.ts --conditions=internal:server --target=bun --packages=external --production --minify --drop console.debug --outfile=dist/server.js"
  },
  "dependencies": {
    "@metafor/engine": "workspace:*",
    "@ui/elements": "workspace:*",
    "@ui/hud": "workspace:*"
  }
}
