{
  "name": "@internal/visual",
  "label": "Визуальная среда Cosmos",
  "version": "0.1.37",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "internal:main": "./main/index.tsx",
      "internal:server": "./server/index.ts"
    },
    "./theme.css": {
      "internal:main": "@zavx0z/immersive-ui-component/theme/theme.css"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "build:main": "bun build ./main/index.tsx --conditions=internal:main --target=browser --production --minify --drop console.debug --outdir=dist/main --splitting",
    "build:server": "bun build ./server/index.ts --conditions=internal:server --target=bun --packages=external --production --minify --drop console.debug --outfile=dist/server.js"
  },
  "dependencies": {
    "@zavx0z/immersive-browser": "^0.0.0",
    "@zavx0z/immersive-component": "^0.0.0",
    "@zavx0z/immersive-dom": "^0.0.0",
    "@zavx0z/immersive-engine": "^0.0.0",
    "@zavx0z/immersive-nodes-layout": "^0.0.0",
    "@zavx0z/immersive-nodes": "^0.0.0",
    "@zavx0z/immersive-nodes-parameter": "^0.0.0",
    "@zavx0z/immersive-nodes-socket": "^0.0.0",
    "@zavx0z/immersive-nodes-tree": "^0.0.0",
    "@zavx0z/immersive-renderer-html": "^0.0.0",
    "@zavx0z/immersive-space": "^0.0.0",
    "@zavx0z/immersive-template": "^0.0.0",
    "@zavx0z/immersive-webgpu": "^0.0.0",
    "@zavx0z/immersive-nodes-node": "^0.0.0",
    "@zavx0z/immersive-ui-component": "^0.0.0",
    "@zavx0z/immersive-ui-component-button-basic": "^0.0.0",
    "@zavx0z/immersive-ui-theme-icon-set": "^0.0.0",
    "@zavx0z/immersive-jsx": "^0.0.0",
    "@zavx0z/immersive-jsx-compiler-bun": "^0.0.0"
  }
}
