{
  "name": "@internal/visual",
  "version": "0.1.20",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "internal:main": "./main/index.ts",
      "internal:server": "./server/index.ts"
    },
    "./theme.css": {
      "internal:main": "./theme.css"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "build:main": "bun build ./main/index.ts --conditions=internal:main --target=browser --production --minify --drop console.debug --outdir=dist/main --splitting",
    "build:server": "bun build ./server/index.ts --conditions=internal:server --target=bun --packages=external --production --minify --drop console.debug --outfile=dist/server.js"
  },
  "dependencies": {
    "@engine/core": "link:@engine/core",
    "@ui/components": "link:@ui/components",
    "@zavx0z/dom": "link:@zavx0z/dom",
    "@zavx0z/react": "link:@zavx0z/react",
    "@zavx0z/renderer": "link:@zavx0z/renderer",
    "@zavx0z/renderer-browser": "link:@zavx0z/renderer-browser",
    "@zavx0z/renderer-webgpu": "link:@zavx0z/renderer-webgpu",
    "@zavx0z/template": "link:@zavx0z/template"
  }
}
