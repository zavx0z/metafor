{
  "name": "@metafor/cosmos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production bun --conditions=hamiltonian:server --conditions=internal:server build.ts",
    "dev": "NODE_ENV=development bun --conditions=hamiltonian:server --conditions=internal:server --port=4444 server",
    "start": "bun --conditions=hamiltonian:server --conditions=internal:server --port=4444 server",
    "test": "bun test",
    "test:load": "tsc --project tests/tsconfig.json --pretty false && bun test tests/load-001.boundary.spec.ts tests/load-001.browser.spec.ts"
  },
  "dependencies": {
    "@hamiltonian/release": "workspace:^0.1.9",
    "@hamiltonian/startup": "workspace:*",
    "@internal/visual": "workspace:^0.1.10"
  }
}
