{
  "name": "@metafor/cosmos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production bun --conditions=cosmos:server --conditions=internal:server build.ts",
    "dev": "env -u COSMOS_RELEASE_INSPECT NODE_ENV=development bun --conditions=cosmos:server --conditions=internal:server --port=4444 server",
    "dev:debug": "test -n \"$COSMOS_RELEASE_INSPECT\" && NODE_ENV=development bun --conditions=cosmos:server --conditions=internal:server --port=4444 server",
    "start": "env -u COSMOS_RELEASE_INSPECT bun --conditions=cosmos:server --conditions=internal:server --port=4444 server",
    "test": "bun test",
    "test:load": "tsc --project tests/tsconfig.json --pretty false && bun test tests/load-001.boundary.spec.ts tests/load-001.browser.spec.ts"
  },
  "dependencies": {
    "@cosmos/release": "workspace:^0.1.18",
    "@cosmos/startup": "workspace:*",
    "@internal/visual": "workspace:^0.1.14"
  },
  "devDependencies": {
    "puppeteer-core": "25.4.0"
  }
}
