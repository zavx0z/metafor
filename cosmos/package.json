{
  "name": "@metafor/cosmos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production bun --conditions=cosmos:server --conditions=internal:server build.ts",
    "dev": "NODE_ENV=development bun --conditions=cosmos:server --conditions=internal:server --port=4444 server",
    "start": "bun --conditions=cosmos:server --conditions=internal:server --port=4444 server",
    "tls:create": "bun run create-tls.ts",
    "test": "bun test",
    "test:load": "tsc --project tests/tsconfig.json --pretty false && bun test tests/load-001.boundary.spec.ts tests/load-001.browser.spec.ts"
  },
  "dependencies": {
    "@metafor/engine": "workspace:*",
    "@metafor/web-push": "workspace:*",
    "@nodes/layout": "workspace:*",
    "@nodes/ui": "workspace:*",
    "@ui/components": "workspace:*",
    "@ui/elements": "workspace:*",
    "nodes": "workspace:*",
    "web-push": "3.6.7",
    "werift": "0.24.3"
  },
  "devDependencies": {
    "@types/web-push": "3.6.4",
    "puppeteer-core": "25.4.0"
  }
}
