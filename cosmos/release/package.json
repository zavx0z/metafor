{
  "name": "@cosmos/release",
  "label": "Релизы Cosmos",
  "version": "0.1.31",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "cosmos:main": "./main/index.ts",
      "cosmos:service": "./service/index.ts",
      "cosmos:server": "./server/index.ts"
    },
    "./node": {"cosmos:server": "./node.ts"}
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "build:main": "bun build ./main/index.ts --conditions=cosmos:main --conditions=internal:main --target=browser --packages=external --production --minify --drop console.debug --outfile=dist/main.js",
    "build:service": "bun build ./service/index.ts --conditions=cosmos:service --target=browser --format=cjs --production --minify --drop console.debug --outfile=dist/service.js",
    "build:server": "bun build ./server/index.ts --conditions=cosmos:server --conditions=internal:server --target=bun --packages=bundle --production --minify --drop console.debug --outdir=dist/server --splitting"
  },
  "dependencies": {
    "@zavx0z/immersive": "^0.0.0",
    "@internal/visual": "workspace:^0.1.10",
    "@metafor/tech-build": "workspace:*",
    "@metafor/tech-peer": "workspace:*",
    "@metafor/tech-release": "workspace:*",
    "werift": "0.23.0",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "boundary": "workspace:*",
    "energy": "workspace:*",
    "@types/serviceworker": "^0.0.200"
  }
}
