{
  "name": "@cosmos/release",
  "label": "Релизы Cosmos",
  "version": "0.3.38",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "cosmos:main": "./main/index.ts",
      "cosmos:service": "./service/index.ts",
      "cosmos:server": "./server/index.ts"
    },
    "./node": {
      "cosmos:server": "./node.ts"
    },
    "./persisted-state.json": {
      "cosmos:server": "./persisted-state.json"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "build:main": "bun build ./main/index.ts --conditions=cosmos:main --conditions=internal:main --target=browser --packages=bundle --external=@internal/visual --production --minify --drop console.debug --outfile=dist/main.js",
    "build:service": "bun build ./service/index.ts --conditions=cosmos:service --target=browser --format=cjs --production --minify --drop console.debug --outfile=dist/service.js",
    "build:server": "bun build ./server/index.ts --conditions=cosmos:server --conditions=internal:server --target=bun --packages=bundle --production --minify --drop console.debug --outdir=dist/server --splitting"
  },
  "dependencies": {
    "@metafor/types": "workspace:*",
    "@metafor/agent": "workspace:*",
    "@metafor/provider": "workspace:*",
    "@zavx0z/provider-tech-peer": "^0.0.0",
    "@zavx0z/storybook-chat-session": "^0.0.0",
    "@zavx0z/storybook-tech-acp": "^0.0.0",
    "@zavx0z/immersive": "^0.0.0",
    "@internal/visual": "workspace:^0.3.0",
    "@metafor/tech-build": "workspace:*",
    "@metafor/tech-peer": "workspace:*",
    "@metafor/tech-release": "workspace:*",
    "werift": "0.23.0",
    "reflect-metadata": "0.2.2",
    "@zavx0z/storybook-app-settings": "^0.0.0",
    "@zavx0z/storybook-app-environment": "^0.0.0",
    "@zavx0z/storybook-app-environment-binding": "^0.0.0",
    "@zavx0z/storybook-package-package-json": "^0.0.0",
    "@zavx0z/storybook-package-env": "^0.0.0",
    "@zavx0z/storybook-package-route-workspaces": "^0.0.0",
    "@zavx0z/storybook-package-metadata-collect": "^0.0.0",
    "@zavx0z/storybook-package-graph-create": "^0.0.0",
    "@zavx0z/storybook-package-index": "^0.0.0",
    "@zavx0z/storybook-package-documentation": "^0.0.0",
    "@zavx0z/ai-workspace": "^0.0.0",
    "@zavx0z/ai-filesystem-list": "^0.0.0",
    "@zavx0z/ai-filesystem-read": "^0.0.0",
    "@zavx0z/ai-filesystem-write": "^0.0.0",
    "@zavx0z/ai-tech-failure": "^0.0.0"
  },
  "devDependencies": {
    "boundary": "workspace:*",
    "energy": "workspace:*",
    "@types/serviceworker": "^0.0.200"
  }
}
