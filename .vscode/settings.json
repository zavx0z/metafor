{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/CVS": true,
        "**/*.crswap": true,
        "**/node_modules": true,
        "**/__pycache__": true,
        ".venv": true,
        ".idea": true
    },
    "hide-files.files": [
        ".idea"
    ],
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lock, bun.lockb, bunfig.toml, .npmrc",
        "*.ts": "${capture}.t.ts, ${capture}.spec.ts",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.html",
    },
    "cSpell.words": [
        "акторных",
        "АЛИАСЫ",
        "апгрейдил",
        "билдера",
        "иммутабельному",
        "иммутабельности",
        "иммутабельных",
        "инкапсулирован",
        "коммита",
        "коммитом",
        "матчеры",
        "неверифицированном",
        "Неверифицированный",
        "промисом",
        "рефакторингом",
        "сериализованной",
        "Сериализованный",
        "сериализовано",
        "Сериализуем",
        "снапшотов",
        "типобезопасен",
        "типобезопасной",
        "типобезопасностью",
        "типобезопасные",
        "типобезопасный",
        "фича",
        "Форкните",
        "фреймворках",
        "bunfig",
        "esac",
        "npmjs",
        "softprops",
        "typedoc"
    ],
    "cSpell.ignorePaths": [
        ".github"
    ]
}