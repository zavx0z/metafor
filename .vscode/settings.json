{
    "markdownlint.config": {
        "MD033": false
    },
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/CVS": true,
        "**/*.crswap": true,
        "**/node_modules": true,
        "**/__pycache__": true,
        ".venv": true,
        ".cursor": true,
        ".cursor/rules": true,
        ".idea": true,
        ".firebase": true,
        ".github": true,
        ".windsurf": true,
        ".vscode": true
    },
    "hide-files.files": [
        ".idea",
        ".firebase",
        ".github",
        ".windsurf",
        ".vscode"
    ],
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lock, bun.lockb, bunfig.toml, .npmrc",
        "*.ts": "${capture}.t.ts, ${capture}.spec.ts, ${capture}.md, ${capture}.styled.ts,",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.html",
        "*.md": "${capture}.ru.md"
    },
    "colorize.languages": [
        "javascript",
        "typescript"
    ],
    "bun.test.filePattern": "**/*{.test.,.spec.,_test_,_spec_}{js,ts,tsx,jsx,mts,cts}",
    "cSpell.words": [],
    "cSpell.ignorePaths": [
        ".github",
        "./core/view/html/tests",
        "./docs",
        "./script",
        ".windsurf"
    ],
    "markdownlint.lintWorkspaceGlobs": [
        "!**/node_modules/**/*.md",
        "!**/docs/**/*.md",
        "!.windsurf/**/*.md"
    ],
    "liveServer.settings.port": 4444
}