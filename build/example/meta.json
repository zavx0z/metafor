{
  "name": "git",
  "fields": {
    "src": {
      "type": "string",
      "required": true,
      "default": "./tmp/edit.json",
      "label": "JSON-patch путь"
    },
    "patches": {
      "type": "array<string>",
      "required": true,
      "default": [],
      "label": "разделенные патчи"
    }
  },
  "superposition": {
    "коммит": {
      "завершено": {}
    },
    "завершено": null
  },
  "processes": {
    "коммит": {
      "type": "action",
      "action": {
        "src": "({ context }) => {\n    return {};\n  }"
      },
      "success": {
        "src": "({ update }) => {\n    update({ src: \"\", patches: [] }, \"s\");\n  }",
        "write": [
          "src",
          "patches"
        ]
      }
    },
    "завершено": {
      "type": "finally",
      "before": {
        "src": "() => {}"
      }
    }
  }
}