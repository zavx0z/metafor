{
  "name": "@internal/example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "internal:main": "./main/index.ts",
      "internal:worker": "./worker/index.ts",
      "internal:service": "./service/index.ts",
      "internal:server": "./server/index.ts",
      "internal:server-worker": "./server-worker/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "build:main": "bun build ./main/index.ts --conditions=internal:main --target=browser --production --minify --drop console.debug --outfile=dist/main.js",
    "build:worker": "bun build ./worker/index.ts --conditions=internal:worker --target=browser --production --minify --drop console.debug --outfile=dist/worker.js",
    "build:service": "bun build ./service/index.ts --conditions=internal:service --target=browser --format=cjs --production --minify --drop console.debug --outfile=dist/service.js",
    "build:server": "bun build ./server/index.ts --conditions=internal:server --target=bun --production --minify --drop console.debug --outfile=dist/server.js",
    "build:server-worker": "bun build ./server-worker/index.ts --conditions=internal:server-worker --target=bun --production --minify --drop console.debug --outfile=dist/server-worker.js"
  },
  "dependencies": {
    "@fixture/library": "1.0.0"
  }
}
