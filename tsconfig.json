{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": [
      "ESNext",
      "DOM",
      "dom.iterable"
    ],
    "types": [
      "@webgpu/types",
      "bun"
    ],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "checkJs": true,
    // Bundler mode
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "types/**/*.d.ts",
    "fixture/**/*.ts",
    "**/*.ts",
    "tests"
  ],
  "exclude": [
    "**/dist-test/*",
    "**/script/**/*",
    "**/docs/**/*",
    "*/dist/**/*",
    "*/node_modules/**/*",
    "pkg/engine/examples/**/*",
    "pkg/engine/src/**/*",
    "pkg/engine/index.ts",
    "pkg/engine/server.ts",
    "pkg/engine/global.d.ts",
    "app/web/runtime/**/*",
    "tests/tmp/**/*",
    ".idea/**/*",
    ".cursor/**/*",
    ".vscode/**/*",
    "./metafor.ts",
    ".ai"
  ]
}
