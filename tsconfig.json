{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": [
      "ESNext",
      "DOM",
      "dom.iterable"
    ],
    "types": [
      "@webgpu/types",
      "bun"
    ],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "checkJs": true,
    // Bundler mode
    "moduleResolution": "bundler",
    "customConditions": [
      "cosmos:server",
      "internal:server"
    ],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "types/**/*.d.ts",
    "fixture/**/*.ts",
    "**/*.ts",
    "tests"
  ],
  "exclude": [
    "**/dist-test/*",
    "**/script/**/*",
    "**/docs/**/*",
    "*/dist/**/*",
    "*/node_modules/**/*",
    "cosmos/release/**/*",
    "cosmos/startup/**/*",
    "cosmos/internal/visual/**/*",
    "cosmos/tests/**/*",
    "tests/tmp/**/*",
    "project/artifacts/**/*",
    "cluster/**/*",
    ".idea/**/*",
    ".cursor/**/*",
    ".vscode/**/*",
    ".ai"
  ]
}
