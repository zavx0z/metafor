{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM",
      "dom.iterable"
    ],
    "types": [
      "@webgpu/types",
      "bun"
    ],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "checkJs": true,
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@zavx0z/immersive-jsx",
    "customConditions": [
      "cosmos:server",
      "internal:server"
    ],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "types/**/*.d.ts",
    "fixture/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "**/dist-test/*",
    "**/script/**/*",
    "**/docs/**/*",
    "*/dist/**/*",
    "*/node_modules/**/*",
    "create-metafor/dsl/**/*",
    "cosmos/release/**/*",
    "cosmos/startup/**/*",
    "cosmos/internal/visual/**/*",
    "cosmos/internal/supervisor/**/*",
    "cosmos/tests/**/*",
    "project/artifacts/**/*",
    "cluster/**/*",
    ".idea/**/*",
    ".cursor/**/*",
    ".vscode/**/*",
    ".ai",
    "quantum/bulk/**/*",
    "pkg/visual/**/*",
    "quantum/dark/server.ts",
    "quantum/dark/server.spec.ts",
    "quantum/dark/index.ts",
    "test-preload.ts",
    "template-plugin.ts",
    "quantum/boundary/incremental.spec.ts",
    "quantum/dark/checkpoint/dissolve-candidate.spec.ts",
    "quantum/tests/agent-session.integration.spec.ts",
    "quantum/tests/graph/bulk-projection.spec.ts",
    "quantum/tests/graph/laboratory.spec.ts",
    "tech/build/spec/fixture/**/*"
  ]
}
