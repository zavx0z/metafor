{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM",
      "dom.iterable"
    ],
    "types": [
      "@webgpu/types",
      "bun"
    ],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "checkJs": true,
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@zavx0z/template",
    "customConditions": [
      "cosmos:server",
      "internal:server"
    ],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "types/**/*.d.ts",
    "fixture/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "**/dist-test/*",
    "**/script/**/*",
    "**/docs/**/*",
    "*/dist/**/*",
    "*/node_modules/**/*",
    "create-metafor/dsl/**/*",
    "cosmos/release/**/*",
    "cosmos/startup/**/*",
    "cosmos/internal/visual/**/*",
    "cosmos/internal/supervisor/**/*",
    "cosmos/tests/**/*",
    "project/artifacts/**/*",
    "cluster/**/*",
    ".idea/**/*",
    ".cursor/**/*",
    ".vscode/**/*",
    ".ai"
  ]
}
