{
  "name": "@ui/panes",
  "version": "0.0.1",
  "description": "Reusable WebGPU UI panes for metafor.",
  "type": "module",
  "private": true,
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./android-pane": "./android-pane.ts",
    "./codex-composer": "./codex-composer.ts",
    "./editor": "./editor/index.ts",
    "./file-list": "./file-list/index.ts",
    "./pane-frame": "./pane-frame.ts",
    "./terminal": "./terminal/index.ts",
    "./todo-pane": "./todo-pane.ts",
    "./syntax": "./editor/languages/pattern-highlighter.ts",
    "./todo-model": "./todo-model.ts",
    "./playground": "./playground/server.ts"
  },
  "scripts": {
    "playground": "bun --hot playground/server.ts",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@ui/components": "workspace:*",
    "@ui/elements": "workspace:*",
    "@metafor/engine": "workspace:*"
  }
}
