                <mxCell id="title" value="Boundary canonical store: откуда приходят данные" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="20" width="820" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="note-main" value="Вопрос графа: &lt;b&gt;из каких таблиц Boundary store берётся каждое значение&lt;/b&gt;.&lt;br/&gt;`boundary$.branes[i]`, `boundary$.fields[i]` и `boundary$.stringTable[i]` повторены по lane только для читаемости. Это всё те же самые канонические таблицы." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7d6;strokeColor=#d6b656;fontSize=13;align=left;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="60" y="70" width="1180" height="74" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="&lt;b&gt;Обозначения&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#2563eb&quot;&gt;Синий&lt;/font&gt; = lookup по индексу&lt;br/&gt;&lt;font color=&quot;#d97706&quot;&gt;Оранжевый&lt;/font&gt; = slice по offset/count&lt;br/&gt;&lt;font color=&quot;#dc2626&quot;&gt;Красный&lt;/font&gt; = lookup по stringIndex&lt;br/&gt;&lt;font color=&quot;#6b7280&quot;&gt;Серый&lt;/font&gt; = семантика локального state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f6f8;strokeColor=#9aa4b2;fontSize=13;align=left;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1280" y="70" width="460" height="110" as="geometry"/>
