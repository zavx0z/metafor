{
  "name": "create-metafor",
  "description": "Meta for...",
  "version": "1.0.44",
  "author": "zavx0z",
  "repository": {
    "type": "git",
    "url": "https://github.com/zavx0z/metafor.git",
    "directory": "create-metafor"
  },
  "main": "dist/cli.js",
  "types": "./index.ts",
  "bin": {
    "create-metafor": "dist/cli.js"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "files": [
    "dist",
    "templates"
  ],
  "keywords": [
    "metafor",
    "scaffold",
    "template",
    "generator",
    "create"
  ],
  "license": "MIT",
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target node --minify && cp -r templates dist/",
    "prepublishOnly": "bun run build",
    "pub": "bun publish --access public",
    "pub:patch": "bun pm version patch && bun run pub",
    "pub:minor": "bun pm version minor && bun run pub",
    "pub:major": "bun pm version major && bun run pub",
    "start": "bun src/cli.ts",
    "dev:bun": "bun --no-cache src/cli.ts",
    "dev:node": "node dist/cli.js",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@boundary/wimp": "workspace:*"
  },
  "type": "module"
}
