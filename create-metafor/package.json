{
  "name": "create-metafor",
  "version": "0.1.0",
  "author": "zavx0z",
  "repository": {
    "type": "git",
    "url": "https://github.com/zavx0z/metafor.git",
    "directory": "create-metafor"
  },
  "main": "dist/cli.js",
  "bin": {
    "create-metafor": "dist/cli.js"
  },
  "description": "Create MetaFor packages — универсальный генератор пакетов для MetaFor framework",
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "files": [
    "dist",
    "templates"
  ],
  "keywords": [
    "metafor",
    "scaffold",
    "template",
    "generator",
    "create"
  ],
  "license": "MIT",
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target node --minify && cp -r templates dist/",
    "prepublishOnly": "bun run build",
    "start": "bun src/cli.ts",
    "dev": "bun --no-cache src/cli.ts",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "type": "module"
}
