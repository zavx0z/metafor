{
  "name": "create-metafor",
  "version": "0.2.25",
  "author": "zavx0z",
  "repository": {
    "type": "git",
    "url": "https://github.com/zavx0z/metafor.git",
    "directory": "create-metafor"
  },
  "main": "dist/cli.js",
  "bin": {
    "create-metafor": "dist/cli.js"
  },
  "description": "Meta for...",
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "files": [
    "dist",
    "templates"
  ],
  "keywords": [
    "metafor",
    "scaffold",
    "template",
    "generator",
    "create"
  ],
  "license": "MIT",
  "scripts": {
    "build": "bun scripts/build",
    "prepublishOnly": "bun run clean && bun run build",
    "pub": "bun publish --access public",
    "pub:patch": "bun pm version patch && bun run pub",
    "pub:minor": "bun pm version minor && bun run pub",
    "pub:major": "bun pm version major && bun run pub",
    "dev": "bun --no-cache src/cli.ts",
    "dev:node": "node dist/cli.js",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "type": "module",
  "dependencies": {
    "ink": "^6.8.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14"
  }
}
