{
  "name": "git",
  "fields": {
    "src": {
      "type": "string",
      "required": true,
      "default": "./tmp/edit.json",
      "label": "JSON-patch путь"
    },
    "patches": {
      "type": "array<string>",
      "required": true,
      "default": [],
      "label": "разделенные патчи"
    },
    "isLoading": {
      "type": "boolean",
      "required": true,
      "default": false,
      "label": "Флаг загрузки"
    }
  },
  "superposition": {
    "коммит": {
      "завершено": {
        "isLoading": false
      },
      "ошибка": {
        "isLoading": true
      }
    },
    "завершено": null,
    "ошибка": {
      "коммит": {}
    }
  },
  "processes": {
    "коммит": {
      "type": "action",
      "label": "Коммит",
      "desc": "Процесс коммита изменений",
      "action": {
        "src": "./actions/commit.ts",
        "importSpecifier": "default"
      },
      "success": {
        "src": "({ update, data }) => {\n    update({ src: \"\", patches: [], isLoading: false }, \"s\");\n  }",
        "write": [
          "src",
          "patches",
          "isLoading"
        ]
      },
      "error": {
        "src": "({ update, error }) => {\n    update({ isLoading: false }, \"e\");\n    console.error(\"\\u041E\\u0448\\u0438\\u0431\\u043A\\u0430 \\u043A\\u043E\\u043C\\u043C\\u0438\\u0442\\u0430:\", error.message);\n  }",
        "write": [
          "isLoading"
        ]
      }
    },
    "завершено": {
      "type": "finally",
      "label": "Завершено",
      "desc": "Очистка после завершения",
      "before": {
        "src": "() => {}"
      }
    }
  },
  "reactions": {
    "reactions": {
      "0": {
        "label": "Обработка сообщений",
        "desc": "Реагирует на внешние события",
        "cond": "({ self, value }) => ({\n      meta: \"user\",\n      value: { gt: 0 }\n    })",
        "read": [
          "isLoading"
        ],
        "write": [
          "isLoading"
        ],
        "src": "({ update, patch }) => {\n      update({ isLoading: true }, \"r:0\");\n      console.log(\"\\u041F\\u043E\\u043B\\u0443\\u0447\\u0435\\u043D\\u043E \\u0441\\u043E\\u043E\\u0431\\u0449\\u0435\\u043D\\u0438\\u0435:\", patch.value);\n    }"
      }
    },
    "superposition": {
      "коммит": [
        "0"
      ]
    }
  },
  "matter": [
    {
      "type": "log",
      "data": "/state",
      "expr": "_[0] === \"\\u043A\\u043E\\u043C\\u043C\\u0438\\u0442\"",
      "child": [
        {
          "tag": "meta-for",
          "type": "meta",
          "string": {
            "src": "meta/status.js"
          },
          "fields": {
            "data": "/value/src",
            "expr": "{ message: \"\\u041A\\u043E\\u043C\\u043C\\u0438\\u0442 \\u0432 \\u043F\\u0440\\u043E\\u0446\\u0435\\u0441\\u0441\\u0435...\", src: _[0] }"
          }
        }
      ]
    },
    {
      "type": "log",
      "data": "/state",
      "expr": "_[0] === \"\\u0437\\u0430\\u0432\\u0435\\u0440\\u0448\\u0435\\u043D\\u043E\"",
      "child": [
        {
          "tag": "meta-for",
          "type": "meta",
          "string": {
            "src": "meta/success.js"
          },
          "fields": {
            "data": "/value/patches",
            "expr": "{ message: \"\\u0413\\u043E\\u0442\\u043E\\u0432\\u043E!\", patches: _[0] }"
          }
        }
      ]
    },
    {
      "type": "log",
      "data": "/state",
      "expr": "_[0] === \"\\u043E\\u0448\\u0438\\u0431\\u043A\\u0430\"",
      "child": [
        {
          "tag": "meta-for",
          "type": "meta",
          "string": {
            "src": "meta/error.js"
          },
          "fields": "{ error: \"\\u041E\\u0448\\u0438\\u0431\\u043A\\u0430 \\u043A\\u043E\\u043C\\u043C\\u0438\\u0442\\u0430\" }"
        }
      ]
    }
  ],
  "mass": {
    "history": [],
    "lastError": null
  }
}
