{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Dark Force — техническое устройство",
  "entryPoints": [
    "dark/force/history.ts",
    "dark/force/lifecycle.ts",
    "dark/force/route.ts",
    "dark/force/store.ts",
    "dark/checkpoint/barrier.ts"
  ],
  "entryPointStrategy": "expand",
  "out": "tmp/typedoc/dark",
  "tsconfig": "tsconfig.json",
  "excludeExternals": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "categorizeByGroup": true
}
