{
  "version": 1,
  "selectors": {
    "quantum": {
      "supported": true,
      "package": "Quantum Storybook",
      "cwd": "quantum/storybook",
      "command": ["bun", "server.ts"],
      "host": "127.0.0.1",
      "hostEnv": "QUANTUM_STORYBOOK_HOST",
      "port": 4019,
      "portEnv": "QUANTUM_STORYBOOK_PORT",
      "origin": "http://127.0.0.1:4019",
      "probePath": "/graph/",
      "httpMarker": "<title>Quantum · лаборатория Graph</title>",
      "ready": {"kind": "dataset", "name": "quantumStorybook", "value": "ready"},
      "canvas": {"selector": "#quantum-storybook-canvas", "capability": "webgpu-diagnostic", "touch": false},
      "pages": [
        {"mountPath": "/graph", "canvas": {"selector": "#quantum-storybook-canvas", "capability": "webgpu-diagnostic", "touch": false}}
      ],
      "routes": {"default": "/graph/"},
      "stateKey": "quantum",
      "logName": "quantum.log"
    }
  }
}
