  "processes": {
    "определение операции": {
      "type": "action",
      "action": {
        "src": "({ core, context }) => {\n    const parts = (context.command || \"\").split(\" \"), command = parts[0];\n    if (!command)\n      throw Error(\"\\u041D\\u0435 \\u0443\\u0434\\u0430\\u043B\\u043E\\u0441\\u044C \\u0438\\u0437\\u0432\\u043B\\u0435\\u0447\\u044C \\u043A\\u043E\\u043C\\u0430\\u043D\\u0434\\u0443\");\n    const args = parts.length > 1 ? parts.slice(1).join(\" \") : null, patterns = core.patterns;\n    let operation = null;\n    for (const [key, regex] of Object.entries(patterns))\n      if (regex.test(command)) {\n        operation = key;\n        break;\n      }\n    if (!operation)\n      throw Error(`\\u041D\\u0435\\u0438\\u0437\\u0432\\u0435\\u0441\\u0442\\u043D\\u0430\\u044F \\u043A\\u043E\\u043C\\u0430\\u043D\\u0434\\u0430: ${context.command}`);\n    return { operation, command, args };\n  }",
        "read": [
          "command"
        ]
      },
      "success": {
        "src": "({ update, data }) => update(data, \"s\")"
      },
      "error": {
        "src": "({ update, error }) => update({ error: error.message }, \"e\")",
        "write": [
          "error"
        ]
      }
    },
    "выполнение": {
      "type": "action",
      "action": {
        "src": "() => null"
      },
      "success": {
        "src": "({ update }) => update({ operation: null }, \"s\")",
        "write": [
          "operation"
        ]
      }
    }
  },
