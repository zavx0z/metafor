{
  "name": "metafor",
  "author": "zavx0z",
  "version": "0.4.0",
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "import": "./index.ts",
      "types": "./index.ts"
    }
  },
  "workspaces": [
    "types",
    "ui/*",
    "pkg/engine",
    "pkg/template",
    "fixture",
    "create-metafor",
    "force",
    "dark",
    "dark/**/*",
    "energy",
    "energy/**/*",
    "matrix",
    "matrix/**/*",
    "bulk",
    "bulk/**/*",
    "github/**/*",
    "boundary",
    "boundary/**/*"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "bun-webgpu": "^0.1.6",
    "dts-bundle-generator": "^9.5.1",
    "fake-indexeddb": "^6.2.5",
    "typedoc": "^0.28.18",
    "typedoc-plugin-merge-modules": "^7.0.0"
  },
  "dependencies": {
    "@metafor/types": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  },
  "scripts": {
    "start": "bun runtime/start.ts",
    "runtime": "bun runtime/start.ts",
    "runtime:domains": "bun run --parallel --filter force --filter boundary --filter dark --filter matrix --filter energy server",
    "runtime:logs": "METAFOR_LOG_IMPULSES=full bun run runtime",
    "runtime:cpu": "METAFOR_WEAK_BACKEND=cpu bun run runtime",
    "runtime:gpu": "METAFOR_WEAK_BACKEND=gpu bun run runtime",
    "force": "bun run --parallel --filter force --filter boundary --filter dark --filter matrix --filter bulk --filter energy server",
    "test:runtime-launch": "bun test runtime/start.spec.ts",
    "test:runtime-universe": "bun test fixture/runtime-universe.spec.ts",
    "test:all": "bun test",
    "clear": "rm -rf node_modules && bun run --parallel --filter '*' clear",
    "build": "bun run build:prod && bun run build:dev",
    "build:watch": "bun run build:dev --watch",
    "build:prod": "bun build index.ts --outdir ./dist --minify --entry-naming [name].min.[ext]",
    "build:dev": "bun build index.ts --outdir ./dist --sourcemap=linked",
    "typegen": "bunx dts-bundle-generator --out-file ./dist/index.d.ts --export-referenced-types false --inline-declare-externals true --no-check -- ../../index.ts",
    "space:build": "bun build metafor.ts --outdir ./dist --sourcemap=linked"
  }
}
