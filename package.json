{
  "name": "metafor",
  "author": "zavx0z",
  "version": "0.4.0",
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "import": "./index.ts",
      "types": "./index.ts"
    }
  },
  "workspaces": [
    "app/application",
    "app/web",
    "ui/*",
    "pkg/**/*",
    "fixture",
    "create-metafor",
    "dark",
    "dark/**/*",
    "energy",
    "energy/**/*",
    "bulk",
    "bulk/**/*",
    "github/**/*",
    "boundary",
    "boundary/**/*"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "bun-webgpu": "^0.1.6",
    "dts-bundle-generator": "^9.5.1",
    "fake-indexeddb": "^6.2.5",
    "typedoc": "^0.28.18",
    "typedoc-plugin-merge-modules": "^7.0.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  },
  "scripts": {
    "postinstall": "bun scripts/setup-tmux.ts --quiet",
    "setup:tmux": "bun scripts/setup-tmux.ts",
    "interpreter": "bun --hot run pkg/interpreter/interpreter.ts",
    "interpreter:dark-server": "bun --hot run pkg/interpreter/interpreter.ts dark/server.spec.ts -timeout=2147483647",
    "interpreter:web": "bun run workspace.app.web:dev",
    "interpreter:multi": "bun --hot run pkg/interpreter/interpreter.ts dark/server.spec.ts -timeout=2147483647 energy/energy.spec.ts dark/tmp/boundary.sqlite",
    "workspace.app.web": "bun run workspace.app.web:dev",
    "workspace.app.web:dev": "bun app/web/run.ts --dev layout",
    "workspace.app.web:prod": "bun app/web/run.ts --prod layout",
    "workspace.app.web:product": "bun run workspace.app.web:prod",
    "workspace.app.web:stop": "bun app/web/run.ts --prod stop",
    "workspace.application": "INTERPRETER_HTTP_PORT=6510 BUN_PROTOCOL_URL=ws://127.0.0.1:6511/ INTERPRETER_DUMP_PATH=app/application/tmp/interpreter/state.json bun --hot run pkg/interpreter/interpreter.ts app/application/energy.server.ts app/application/dark.server.ts -env.BOUNDARY_PATH=app/application/tmp/boundary.sqlite app/application/tmp/boundary.sqlite",
    "voice:assets": "bun --filter @metafor/voice assets",
    "voice:playground": "bun --filter @metafor/voice playground",
    "voice:smoke": "bun --filter @metafor/voice smoke",
    "voice:asr:tunnel": "ssh -N -L 127.0.0.1:8877:127.0.0.1:8787 ai-srv",
    "voice:asr:health": "curl -fsS http://127.0.0.1:8877/health",
    "voice:vosk:health": "curl -fsS http://127.0.0.1:4765/health",
    "voice:health": "bun run voice:vosk:health && printf '\\n' && bun run voice:asr:health",
    "upd": "bun update --latest && bun i",
    "clear": "rm -rf node_modules && bun run --parallel --filter '*' clear",
    "test:dark-server": "bun test dark/server.spec.ts",
    "test:all": "bun test",
    "build": "bun run build:prod && bun run build:dev",
    "build:watch": "bun run build:dev --watch",
    "build:prod": "bun build index.ts --outdir ./dist --minify --entry-naming [name].min.[ext]",
    "build:dev": "bun build index.ts  --outdir ./dist --sourcemap=linked",
    "typegen": "bunx dts-bundle-generator --out-file ./dist/index.d.ts --export-referenced-types false --inline-declare-externals true --no-check -- ../../index.ts",
    "space:build": "bun build metafor.ts --outdir ./dist --sourcemap=linked",
    "zavx0z:build": "bun run --parallel --filter '@zavx0z/*' build",
    "zavx0z:watch": "bun run --parallel --filter '@zavx0z/*' build --watch",
    "zavx0z:clean": "for dir in zavx0z/*/; do rm -f \"$dir\"/git*.json; done"
  }
}
