{
  "name": "@metafor/space",
  "author": "zavx0z",
  "version": "0.4.0",
  "type": "module",
  "private": false,
  "workspaces": [
    "sqlite",
    "dark",
    "dark/*",
    "boundary",
    "boundary/*",
    "shared/*",
    "bulk",
    "bulk/*",
    "metafor/*",
    "github/**/*",
    "fixture",
    "app/*"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "bun-webgpu": "^0.1.6",
    "dts-bundle-generator": "^9.5.1",
    "fake-indexeddb": "^6.2.5",
    "typedoc": "^0.28.18",
    "typedoc-plugin-merge-modules": "^7.0.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  },
  "scripts": {
    "dev": "bun --filter @app/web dev",
    "upd": "bun update --latest && bun i",
    "clear": "rm -rf node_modules && bun run --parallel --filter '*' clear",
    "test:all": "bun test",
    "typegen": "bun --filter @metafor/dsl typegen",
    "build": "bun --filter @metafor/dsl build",
    "space:build": "bun build metafor.ts --outdir ./dist --sourcemap=linked",
    "zavx0z:build": "bun run --parallel --filter '@zavx0z/*' build",
    "zavx0z:watch": "bun run --parallel --filter '@zavx0z/*' build --watch",
    "zavx0z:clean": "for dir in zavx0z/*/; do rm -f \"$dir\"/git*.json; done"
  }
}
