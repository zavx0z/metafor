{
  "name": "metafor",
  "author": "zavx0z",
  "version": "0.4.0",
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "import": "./index.ts",
      "types": "./index.ts"
    }
  },
  "workspaces": [
    "types",
    "force",
    "dark",
    "boundary",
    "boundary/atom",
    "boundary/topology",
    "boundary/wimp",
    "matrix",
    "matrix/gravity",
    "matrix/strong",
    "matrix/weak",
    "energy",
    "bulk",
    "bulk/gravity",
    "bulk/strong",
    "bulk/weak",
    "dark/gravity",
    "dark/strong",
    "pkg/engine",
    "pkg/template",
    "pkg/ui/elements",
    "pkg/ui/components",
    "pkg/ui/hud",
    "fixture",
    "create-metafor"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.5.0",
    "@webgpu/types": "^0.1.68",
    "bun-webgpu": "^0.1.6",
    "dts-bundle-generator": "^9.5.1",
    "typedoc": "^0.28.18",
    "typedoc-plugin-merge-modules": "^7.0.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@metafor/types": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  },
  "scripts": {
    "dev:core": "bun run --parallel --filter force --filter boundary --filter dark --filter matrix --filter energy dev",
    "dev:world": "bun run --parallel --filter force --filter boundary --filter dark --filter matrix --filter energy --filter bulk dev",
    "start:core": "bun run --parallel --filter force --filter boundary --filter dark --filter matrix --filter energy start",
    "start:world": "bun run --parallel --filter force --filter boundary --filter dark --filter matrix --filter energy --filter bulk start",
    "logs:core": "METAFOR_LOG_IMPULSES=full bun run dev:core",
    "test": "FORCE_ADDRESS=ws://127.0.0.1:1 FORCE_RECONNECT=0 bun test",
    "typecheck": "tsc --noEmit --pretty false",
    "check": "bun run typecheck && bun run test",
    "build": "bun run build:prod && bun run build:dev",
    "build:watch": "bun run build:dev --watch",
    "build:prod": "bun build index.ts --outdir ./dist --minify --entry-naming [name].min.[ext]",
    "build:dev": "bun build index.ts --outdir ./dist --sourcemap=linked",
    "typegen": "bunx dts-bundle-generator --out-file ./dist/index.d.ts --export-referenced-types false --inline-declare-externals true --no-check -- ../../index.ts",
    "space:build": "bun build metafor.ts --outdir ./dist --sourcemap=linked"
  }
}
