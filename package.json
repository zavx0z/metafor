{
  "name": "everywhere-everything",
  "author": "zavx0z",
  "version": "0.4.0",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "^1.2.22",
    "dts-bundle-generator": "^9.5.1",
    "typedoc": "^0.28.13",
    "typedoc-plugin-merge-modules": "^7.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build:metafor": "bun build metafor.ts --outdir ./dist",
    "typegen:metafor": "dts-bundle-generator --out-file ./dist/metafor.d.ts --export-referenced-types true --inline-declare-global true --inline-declare-externals true --external-inlines @zavx0z/context --external-inlines @zavx0z/template -- metafor.ts",
    "build:actor": "bun build actor.ts --outdir ./dist",
    "typegen:actor": "dts-bundle-generator --out-file ./dist/actor.d.ts --export-referenced-types true --inline-declare-global true --inline-declare-externals true --external-inlines @zavx0z/context --external-inlines @zavx0z/template -- actor.ts",
    "upd": "bun update --latest && bun i",
    "rebuild:dev": "bun run server:build:dev && bun run web:build:dev",
    "server:build:dev": "bun run server/script/build.ts --dev",
    "server:build:prod": "bun run server/script/build.ts --prod",
    "server:typegen": "bun run server/script/typegen.ts",
    "web:build:dev": "bun run web/script/build.ts --dev",
    "web:build:prod": "bun run web/script/build.ts --prod",
    "web:typegen": "bun run web/script/typegen.ts",
    "docs": "typedoc",
    "doc:push": "bun run script/doc.push.ts",
    "web:build:watch": "bun build ./web/metafor --outdir ./dist/web --watch"
  },
  "dependencies": {
    "@zavx0z/context": "2.0.1",
    "@zavx0z/template": "^2.5.7"
  }
}
