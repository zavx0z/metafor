{
  "name": "@zavx0z/metafor",
  "version": "0.2.3",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zavx0z/metafor.git"
  },
  "main": "./dist/metafor.js",
  "types": "./dist/metafor.d.ts",
  "exports": {
    ".": {
      "import": "./dist/metafor.js",
      "types": "./dist/metafor.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "devDependencies": {
    "@happy-dom/global-registrator": "^18.0.1",
    "@types/bun": "^1.2.19",
    "dts-bundle-generator": "^9.5.1",
    "happy-dom": "^18.0.1",
    "typedoc": "^0.28.8",
    "typedoc-plugin-include-example": "^2.1.2",
    "typedoc-plugin-merge-modules": "^7.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "scripts": {
    "upd": "bun update --latest && bun i",
    "build:dev": "bun run build:js --dev",
    "build:prod": "bun run build:js --prod",
    "publish:npm": "bun run build:prod && bun publish --access public",
    "build:js": "bun run script/build.ts",
    "publish:dry": "bun run build:prod && bun publish --dry-run",
    "CONTEXT:TEST": "bun test context",
    "HTML:TEST": "bun test html",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "merge:doc": "bun run script/merge.doc.ts",
    "deploy:docs": "firebase deploy --only hosting:docs",
    "deploy:docs:preview": "firebase hosting:channel:deploy preview",
    "firebase:targets": "firebase target",
    "firebase:sites": "firebase hosting:sites:list"
  }
}
