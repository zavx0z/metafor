{
  "name": "metafor",
  "author": "zavx0z",
  "version": "0.4.0",
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "import": "./index.ts",
      "types": "./index.ts"
    }
  },
  "workspaces": [
    "types",
    "shared",
    "dark",
    "boundary",
    "boundary/atom",
    "boundary/topology",
    "boundary/wimp",
    "matrix",
    "matrix/gravity",
    "matrix/strong",
    "matrix/weak",
    "energy",
    "bulk",
    "bulk/gravity",
    "bulk/strong",
    "bulk/weak",
    "dark/gravity",
    "dark/strong",
    "pkg/engine",
    "pkg/template",
    "pkg/ui/elements",
    "pkg/ui/components",
    "pkg/ui/hud",
    "pkg/visual",
    "fixture",
    "create-metafor"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.5.0",
    "@webgpu/types": "^0.1.68",
    "bun-webgpu": "^0.1.6",
    "dts-bundle-generator": "^9.5.1",
    "typedoc": "^0.28.18",
    "typedoc-plugin-merge-modules": "^7.0.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@metafor/types": "workspace:*",
    "shared": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  },
  "scripts": {
    "runtime:universe": "bun runtime/universe.ts",
    "runtime:universe:once": "bun runtime/universe.ts --once",
    "runtime:universe:logs": "METAFOR_LOG_IMPULSES=full bun runtime/universe.ts",
    "visual:playground": "bun pkg/visual/playground/server.ts",
    "boundary:backup": "bun runtime/boundary-backup.ts",
    "checkpoint:capture": "bun runtime/checkpoint.ts",
    "test": "FORCE_ADDRESS=ws://127.0.0.1:1 FORCE_RECONNECT=0 bun test --path-ignore-patterns='cluster/**'",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:expect-errors": "bun ./tests/types/verify-expect-errors.ts",
    "check": "bun run typecheck && bun run typecheck:expect-errors && bun run test",
    "docs:matrix": "typedoc --options typedoc.matrix.json",
    "docs:engine": "bun run --cwd pkg/engine build:docs",
    "docs:dark": "typedoc --options typedoc.dark.json",
    "docs:boundary": "typedoc --options typedoc.boundary.json",
    "docs:bulk": "typedoc --options typedoc.bulk.json",
    "build": "bun run build:prod && bun run build:dev",
    "build:watch": "bun run build:dev --watch",
    "build:prod": "bun build index.ts --outdir ./dist --minify --entry-naming [name].min.[ext]",
    "build:dev": "bun build index.ts --outdir ./dist --sourcemap=linked",
    "typegen": "bunx dts-bundle-generator --out-file ./dist/index.d.ts --export-referenced-types false --inline-declare-externals true --no-check -- ../../index.ts",
    "space:build": "bun build metafor.ts --outdir ./dist --sourcemap=linked"
  }
}
