{
  "name": "metafor",
  "author": "zavx0z",
  "version": "0.4.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "types",
    "shared",
    "quantum/dark",
    "quantum/dark/types",
    "quantum/boundary",
    "quantum/boundary/atom",
    "quantum/boundary/topology",
    "quantum/boundary/wimp",
    "quantum/matrix",
    "quantum/matrix/types",
    "quantum/matrix/gravity",
    "quantum/matrix/strong",
    "quantum/matrix/weak",
    "quantum/energy",
    "quantum/energy/types",
    "quantum/bulk",
    "quantum/bulk/types",
    "quantum/bulk/gravity",
    "quantum/bulk/strong",
    "quantum/bulk/weak",
    "quantum/dark/gravity",
    "cosmos",
    "cosmos/internal/visual",
    "cosmos/internal/supervisor",
    "cosmos/release",
    "cosmos/startup",
    "pkg/engine",
    "pkg/web-push",
    "pkg/nodes",
    "pkg/nodes/layout",
    "pkg/nodes/ui",
    "pkg/ui/elements",
    "pkg/ui/components",
    "pkg/ui/playground",
    "pkg/ui/hud",
    "pkg/visual",
    "fixture",
    "create-metafor",
    "create-metafor/dsl",
    "create-metafor/template"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.5.0",
    "@webgpu/types": "^0.1.68",
    "bun-webgpu": "^0.1.6",
    "dts-bundle-generator": "^9.5.1",
    "typedoc": "^0.28.18",
    "typedoc-plugin-merge-modules": "^7.0.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@metafor/types": "workspace:*",
    "shared": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  },
  "scripts": {
    "runtime:universe": "bun cosmos/internal/supervisor/universe.ts",
    "runtime:universe:once": "bun cosmos/internal/supervisor/universe.ts --once",
    "runtime:universe:logs": "METAFOR_LOG_IMPULSES=full bun cosmos/internal/supervisor/universe.ts",
    "nodes:playground": "bun run --cwd pkg/nodes/layout playground",
    "nodes:components": "bun run --cwd pkg/nodes/ui playground",
    "visual:playground": "bun pkg/visual/playground/server.ts",
    "boundary:backup": "bun quantum/boundary/backup.ts",
    "checkpoint:capture": "bun quantum/dark/checkpoint/cli.ts",
    "test": "FORCE_ADDRESS=ws://127.0.0.1:1 FORCE_RECONNECT=0 bun test --path-ignore-patterns='cluster/**'",
    "typecheck": "bun run --filter @metafor/dsl typecheck && bun run --filter @metafor/template typecheck && bun run --filter @internal/supervisor typecheck && bun run --filter @cosmos/startup typecheck && bun run --filter @cosmos/release typecheck && bun run --filter @internal/visual typecheck && tsc --project cosmos/tests/tsconfig.json --pretty false && tsc --project tsconfig.json --pretty false",
    "typecheck:expect-errors": "bun run --filter @metafor/dsl typecheck:expect-errors",
    "check": "bun run typecheck && bun run typecheck:expect-errors && bun run test",
    "docs:matrix": "typedoc --options quantum/matrix/typedoc.json",
    "docs:engine": "bun run --cwd pkg/engine build:docs",
    "docs:layout": "bun run --cwd pkg/nodes/layout build:docs",
    "docs:dark": "typedoc --options quantum/dark/typedoc.json",
    "docs:boundary": "typedoc --options quantum/boundary/typedoc.json",
    "docs:bulk": "typedoc --options quantum/bulk/typedoc.json",
    "build": "bun run build:prod && bun run build:dev",
    "build:watch": "bun run build:dev --watch",
    "build:prod": "bun build create-metafor/dsl/index.ts --outdir ./dist --minify --entry-naming [name].min.[ext]",
    "build:dev": "bun build create-metafor/dsl/index.ts --outdir ./dist --sourcemap=linked",
    "typegen": "bunx dts-bundle-generator --out-file ./dist/index.d.ts --export-referenced-types false --inline-declare-externals true --no-check -- create-metafor/dsl/index.ts",
    "space:build": "bun build create-metafor/dsl/metafor.ts --outdir ./dist --sourcemap=linked"
  }
}
