{
  "name": "metafor",
  "label": "MetaFor",
  "author": "zavx0z",
  "version": "0.4.0",
  "packageManager": "bun@1.4.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "types",
    "shared",
    "tech/release",
    "quantum/dark/types",
    "quantum/boundary",
    "quantum/boundary/types",
    "quantum/boundary/atom",
    "quantum/boundary/topology",
    "quantum/boundary/wimp",
    "quantum/matrix",
    "quantum/matrix/types",
    "quantum/matrix/gravity",
    "quantum/matrix/strong",
    "quantum/matrix/weak",
    "quantum/energy",
    "quantum/energy/types",
    "quantum/dark/gravity",
    "cosmos",
    "cosmos/internal/visual",
    "cosmos/release",
    "cosmos/startup",
    "pkg/web-push",
    "pkg/node-tree",
    "fixture",
    "create-metafor",
    "create-metafor/dsl"
  ],
  "devDependencies": {
    "@zavx0z/highlighter": "link:@zavx0z/highlighter",
    "@types/bun": "^1.4.0",
    "@types/node": "^25.5.0",
    "@webgpu/types": "^0.1.68",
    "bun-webgpu": "^0.1.6",
    "oxc-parser": "^0.146.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@metafor/types": "workspace:*",
    "shared": "workspace:*",
    "@zavx0z/immersive-template": "^0.0.0",
    "@zavx0z/immersive-jsx": "^0.0.0",
    "@zavx0z/immersive-jsx-compiler-bun": "^0.0.0",
    "@zavx0z/immersive-ui-component-button-basic": "^0.0.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "scripts": {
    "boundary:backup": "bun quantum/boundary/backup.ts",
    "checkpoint:capture": "bun quantum/dark/checkpoint/cli.ts",
    "test": "FORCE_ADDRESS=ws://127.0.0.1:1 FORCE_RECONNECT=0 bun test --path-ignore-patterns='cluster/**' --path-ignore-patterns='quantum/bulk/**' --path-ignore-patterns='pkg/visual/**' --path-ignore-patterns='cosmos/internal/supervisor/**' --path-ignore-patterns='quantum/dark/server.spec.ts' --path-ignore-patterns='quantum/boundary/incremental.spec.ts' --path-ignore-patterns='quantum/dark/checkpoint/dissolve-candidate.spec.ts' --path-ignore-patterns='quantum/tests/agent-session.integration.spec.ts' --path-ignore-patterns='quantum/tests/graph/bulk-projection.spec.ts' --path-ignore-patterns='quantum/tests/graph/laboratory.spec.ts'",
    "typecheck": "bun run --filter @metafor/dsl typecheck && bun run --filter @cosmos/startup typecheck && bun run --filter @cosmos/release typecheck && bun run --filter @internal/visual typecheck && tsc --project cosmos/tests/tsconfig.json --pretty false && tsc --project tsconfig.json --pretty false",
    "typecheck:expect-errors": "bun run --filter @metafor/dsl typecheck:expect-errors",
    "check": "bun run typecheck && bun run typecheck:expect-errors && bun run test",
    "build": "bun run build:prod && bun run build:dev",
    "build:watch": "bun run build:dev --watch",
    "build:prod": "bun build create-metafor/dsl/index.ts --outdir ./dist --minify --entry-naming [name].min.[ext]",
    "build:dev": "bun build create-metafor/dsl/index.ts --outdir ./dist --sourcemap=linked",
    "space:build": "bun build create-metafor/dsl/metafor.ts --outdir ./dist --sourcemap=linked"
  },
  "overrides": {
    "@zavx0z/immersive-browser": "link:@zavx0z/immersive-browser",
    "@zavx0z/immersive-component": "link:@zavx0z/immersive-component",
    "@zavx0z/immersive-dom": "link:@zavx0z/immersive-dom",
    "@zavx0z/immersive-engine": "link:@zavx0z/immersive-engine",
    "@zavx0z/immersive-jsx": "link:@zavx0z/immersive-jsx",
    "@zavx0z/immersive-jsx-compiler-bun": "link:@zavx0z/immersive-jsx-compiler-bun",
    "@zavx0z/immersive-nodes": "link:@zavx0z/immersive-nodes",
    "@zavx0z/immersive-nodes-layout": "link:@zavx0z/immersive-nodes-layout",
    "@zavx0z/immersive-nodes-node": "link:@zavx0z/immersive-nodes-node",
    "@zavx0z/immersive-nodes-parameter": "link:@zavx0z/immersive-nodes-parameter",
    "@zavx0z/immersive-nodes-socket": "link:@zavx0z/immersive-nodes-socket",
    "@zavx0z/immersive-nodes-tree": "link:@zavx0z/immersive-nodes-tree",
    "@zavx0z/immersive-renderer-html": "link:@zavx0z/immersive-renderer-html",
    "@zavx0z/immersive-space": "link:@zavx0z/immersive-space",
    "@zavx0z/immersive-template": "link:@zavx0z/immersive-template",
    "@zavx0z/immersive-ui-component": "link:@zavx0z/immersive-ui-component",
    "@zavx0z/immersive-ui-component-button-basic": "link:@zavx0z/immersive-ui-component-button-basic",
    "@zavx0z/immersive-ui-theme-icon-set": "link:@zavx0z/immersive-ui-theme-icon-set",
    "@zavx0z/immersive-webgpu": "link:@zavx0z/immersive-webgpu"
  }
}
