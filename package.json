{
  "name": "@metafor/space",
  "author": "zavx0z",
  "version": "0.4.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "./meta",
    "./actor",
    "./infra/*"
  ],
  "devDependencies": {
    "@types/bun": "^1.2.23",
    "dts-bundle-generator": "^9.5.1",
    "typedoc": "^0.28.13",
    "typedoc-plugin-merge-modules": "^7.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "scripts": {
    "upd": "bun update --latest && bun i",
    "build": "bun --filter @metafor/schema build && bun --filter @metafor/base typegen",
    "typegen": "bun --filter @metafor/schema typegen && bun --filter @metafor/base typegen"
  },
  "dependencies": {
    "@zavx0z/context": "2.3.0",
    "@zavx0z/template": "^2.6.1"
  }
}
