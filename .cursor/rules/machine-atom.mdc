## Полная структура конечного автомата

```javascript
const atom = Atom("WebSocketManager")
  .states("ПОДКЛЮЧАЕТСЯ", "ОТКРЫТ", "ЗАКРЫТ")
  .context({
    uri: t.string({title: "Адрес", default: "wss://localhost:3000"}),
    readyState: t.enum(0, 1, 2, 3)({title: "Состояние", default: 0}),
    retry: t.number({title: "Попытка", default: 50})
  })
  .collapses([
    {
      from: "ПОДКЛЮЧАЕТСЯ",
      action: "init",
      to: [
        {state: "ОТКРЫТ", trigger: {readyState: 1}},
        {state: "ЗАКРЫТ", trigger: {retry: 0}}
      ]
    },
    {
      from: "ОТКРЫТ",
      action: "close",
      to: [{state: "ЗАКРЫТ", trigger: {readyState: 2}}]
    }
  ])
  .core(({update, context}) => {
    let ws = null
    return {
      connect: () => {
        ws = new WebSocket(context.uri)
        ws.addEventListener("open", () => update({readyState: 1}))
        ws.addEventListener("message", event => update({message: event.data}))
        ws.addEventListener("close", event => {
          update({readyState: 2, error: event.reason})
          ws = null
        })
      },
      sendMessage: message => {
        if (ws && ws.readyState === WebSocket.OPEN) {
          ws.send(message)
        }
      },
      closeConnection: () => {
        if (ws) ws.close()
      }
    }
  })
  .actions({
    init({core}) {
      core.connect()
    },
    close() {
      console.log("Соединение закрыто")
    },
    retry({update, context}) {
      const timeout = context.retry > 10 ? 1000 : 5000
      setTimeout(() => update({retry: context.retry - 1}), timeout)
    }
  })
  .reactions([])
  .create({
    state: "ПОДКЛЮЧАЕТСЯ",
    context: {
      uri: "wss://example.com"
    }
  })
```
