{
  "config": {
    "default": true,
    
    // MD004: Стиль маркированных списков (* vs -)
    // Отключено: разрешены оба стиля
    "MD004": false,
    
    // MD013: Длина строки (80 символов)
    // Отключено: для русского текста ограничение непрактично
    "MD013": false,
    
    // MD033: Inline HTML теги
    // Отключено: иногда необходимы для специфичных случаев
    "MD033": false,
    
    // MD041: Первая строка должна быть заголовком H1
    // Отключено: не все файлы начинаются с заголовка
    "MD041": false,
    
    // MD045: Изображения без alt-текста
    // Отключено: не критично для технической документации
    "MD045": false,
    
    // MD060: Стиль таблиц (выравнивание pipe)
    // Отключено: skill table-format автоматически исправляет
    "MD060": false
  }
}
