{
  "name": "@startup/main",
  "private": true,
  "type": "module",
  "exports": "./index.ts",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "prebuild": "bun run typecheck",
    "build": "if [ \"$NODE_ENV\" = development ]; then bun run build:development; else bun run build:production; fi",
    "build:development": "bun build ./index.ts --target=browser --external=/code?module=@import/main --minify --sourcemap=inline --outfile=dist/index.js",
    "build:production": "bun build ./index.ts --target=browser --external=/code?module=@import/main --production --minify --drop console.debug --outfile=dist/index.js"
  }
}
