{
  "name": "@startup/service",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "exports": "./index.ts",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "prebuild": "bun run typecheck",
    "build": "bun build ./index.ts --target=browser --production --minify --drop console.debug --outfile=dist/index.js"
  },
  "artifact": {
    "cache": "startup",
    "headers": {
      "Content-Security-Policy": "script-src 'unsafe-eval'",
      "Service-Worker-Allowed": "/"
    }
  },
  "devDependencies": {
    "@types/serviceworker": "^0.0.200"
  }
}
