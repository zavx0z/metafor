{
  "name": "@startup/service",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "metafor:service-worker": {
        "types": "./index.ts",
        "browser": "./index.ts"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "typecheck:service-worker": "tsc --project tsconfig.json --pretty false",
    "prebuild": "bun run typecheck",
    "prebuild:service-worker": "bun run typecheck:service-worker",
    "build": "bun build ./index.ts --conditions=metafor:service-worker --target=browser --production --minify --drop console.debug --outfile=dist/index.js",
    "build:service-worker": "bun build ./index.ts --conditions=metafor:service-worker --target=browser --production --minify --drop console.debug --outfile=dist/index.js"
  },
  "artifact": {
    "headers": {
      "Content-Security-Policy": "script-src 'unsafe-eval'",
      "Service-Worker-Allowed": "/"
    }
  },
  "devDependencies": {
    "@types/serviceworker": "^0.0.200"
  }
}
