{
  "name": "@release/main",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "metafor:main": {
        "types": "./index.d.ts",
        "browser": "./main.ts"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "typecheck:main": "tsc --project tsconfig.json --pretty false",
    "prebuild": "bun run typecheck",
    "prebuild:main": "bun run typecheck:main",
    "build": "bun build ./main.ts --conditions=metafor:main --target=browser --packages=external --production --minify --drop console.debug --outfile=dist/index.js",
    "build:main": "bun build ./main.ts --conditions=metafor:main --target=browser --packages=external --production --minify --drop console.debug --outfile=dist/index.js"
  },
  "dependencies": {
    "@internal/visual": "workspace:^0.1.0"
  },
  "artifact": {
    "cache": "release"
  }
}
