{
  "name": "@release/main",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./main.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "prebuild": "bun run typecheck",
    "build": "bun build ./main.ts --target=browser --packages=external --production --minify --drop console.debug --outfile=dist/index.js"
  },
  "dependencies": {
    "@internal/visual": "workspace:^0.1.0"
  },
  "artifact": {
    "cache": "release"
  }
}
