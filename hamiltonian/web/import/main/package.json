{
  "name": "@import/main",
  "private": true,
  "type": "module",
  "exports": "./main.ts",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "prebuild": "bun run typecheck",
    "build": "if [ \"$NODE_ENV\" = development ]; then bun run build:development; else bun run build:production; fi",
    "build:development": "bun build ./main.ts --target=browser --minify --sourcemap=inline --outfile=dist/index.js",
    "build:production": "bun build ./main.ts --target=browser --production --minify --drop console.debug --outfile=dist/index.js"
  },
  "dependencies": {
    "@internal/visual": "workspace:*"
  }
}
