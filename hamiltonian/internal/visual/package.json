{
  "name": "@internal/visual",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "browser": "./endpoint.ts",
      "default": "./index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "prebuild": "bun run typecheck",
    "build": "bun build ./index.ts --target=browser --production --minify --drop console.debug --outfile=dist/index.js"
  },
  "dependencies": {
    "@metafor/engine": "workspace:*",
    "@ui/elements": "workspace:*",
    "@ui/hud": "workspace:*"
  },
  "artifact": {
    "cache": "internal"
  }
}
