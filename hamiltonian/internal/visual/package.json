{
  "name": "@internal/visual",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "metafor:main": {
        "types": "./index.ts",
        "browser": "./index.ts"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "typecheck:main": "tsc --project tsconfig.json --pretty false",
    "prebuild": "bun run typecheck",
    "prebuild:main": "bun run typecheck:main",
    "build": "bun build ./index.ts --conditions=metafor:main --target=browser --production --minify --drop console.debug --outfile=dist/index.js",
    "build:main": "bun build ./index.ts --conditions=metafor:main --target=browser --production --minify --drop console.debug --outfile=dist/index.js"
  },
  "dependencies": {
    "@metafor/engine": "workspace:*",
    "@ui/elements": "workspace:*",
    "@ui/hud": "workspace:*"
  },
  "artifact": {
    "cache": "internal"
  }
}
