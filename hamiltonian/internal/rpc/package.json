{
  "name": "@internal/rpc",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./service/web/index.ts",
    "./server": "./server/index.ts",
    "./service/web": "./service/web/index.ts"
  },
  "scripts": {
    "typecheck": "bun run typecheck:server && bun run typecheck:service:web",
    "typecheck:server": "tsc --project server/tsconfig.json --pretty false",
    "typecheck:service:web": "tsc --project service/web/tsconfig.json --pretty false",
    "prebuild": "bun run typecheck",
    "build": "if [ \"$NODE_ENV\" = development ]; then bun run build:development; else bun run build:production; fi",
    "build:development": "bun build ./service/web/index.ts --target=browser --format=iife --minify --sourcemap=inline --outfile=dist/index.js",
    "build:production": "bun build ./service/web/index.ts --target=browser --format=iife --production --minify --drop console.debug --outfile=dist/index.js"
  },
  "devDependencies": {
    "@types/serviceworker": "^0.0.200"
  }
}
