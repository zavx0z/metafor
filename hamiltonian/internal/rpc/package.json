{
  "name": "@internall/rpc",
  "private": true,
  "type": "module",
  "exports": {
    "./server": "./server/index.ts",
    "./service/web": "./service/web/index.ts",
    "./service/web/route": "./service/web/route.ts"
  },
  "scripts": {
    "typecheck": "bun run typecheck:server && bun run typecheck:service:web",
    "typecheck:server": "tsc --project server/tsconfig.json --pretty false",
    "typecheck:service:web": "tsc --project service/web/tsconfig.json --pretty false",
    "build": "bun run typecheck && bun build @internall/rpc/service/web --target=browser --format=iife --outfile=service/web/dist/index.js"
  },
  "devDependencies": {
    "@types/serviceworker": "^0.0.200"
  }
}
