{
  "name": "@metafor/hamiltonian",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run --parallel --if-present --filter '@startup/*' --filter '@import/*' --filter '@internal/*' build",
    "start": "bun --port=4444 server",
    "tls:create": "bun run create-tls.ts",
    "test": "bun test",
    "test:load": "tsc --project tests/tsconfig.json --pretty false && bun test tests/load-001.boundary.spec.ts tests/load-001.browser.spec.ts"
  },
  "dependencies": {
    "@internal/rpc": "workspace:*",
    "@hamiltonian/visual": "workspace:*",
    "@metafor/engine": "workspace:*",
    "@metafor/web-push": "workspace:*",
    "@nodes/layout": "workspace:*",
    "@nodes/hud": "workspace:*",
    "@nodes/ui": "workspace:*",
    "@ui/components": "workspace:*",
    "@ui/elements": "workspace:*",
    "nodes": "workspace:*",
    "web-push": "3.6.7",
    "werift": "0.24.3"
  },
  "devDependencies": {
    "@types/web-push": "3.6.4",
    "puppeteer-core": "25.4.0"
  }
}
