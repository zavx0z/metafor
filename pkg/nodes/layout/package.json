{
  "name": "@nodes/layout",
  "version": "0.0.1",
  "description": "Minimal ELK-like compound graph layout and orthogonal routing.",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
