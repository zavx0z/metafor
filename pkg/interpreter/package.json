{
  "name": "@metafor/interpreter",
  "version": "0.0.1",
  "description": "MetaFor live interpreter for Bun modules.",
  "type": "module",
  "private": true,
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./srv": "./srv.ts",
    "./web": "./web.ts",
    "./interpreter": "./interpreter.ts"
  },
  "bin": {
    "metafor-interpreter": "./interpreter.ts"
  },
  "dependencies": {
    "@metafor/browser-agent": "workspace:*",
    "@metafor/pty": "workspace:*",
    "@ui/components": "workspace:*",
    "@ui/elements": "workspace:*",
    "@ui/hud": "workspace:*",
    "@ui/panes": "workspace:*",
    "source-map-js": "^1.2.1"
  },
  "scripts": {
    "interpreter": "bun --hot run interpreter.ts",
    "interpreter:dark-server": "bun --hot run interpreter.ts ../../dark/server.spec.ts -timeout=2147483647",
    "interpreter:multi": "bun --hot run interpreter.ts ../../dark/server.spec.ts -timeout=2147483647 ../../matrix/matrix.spec.ts ../../dark/tmp/boundary.sqlite",
    "typecheck": "tsc --noEmit --pretty false"
  }
}
