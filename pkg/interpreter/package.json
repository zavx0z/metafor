{
  "name": "@metafor/interpreter",
  "version": "0.0.1",
  "description": "Bun WebKit Inspector sidecar for the MetaFor interpreter.",
  "type": "module",
  "private": true,
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./interpreter": "./interpreter.ts"
  },
  "bin": {
    "metafor-interpreter": "./interpreter.ts"
  },
  "dependencies": {
    "@ui/components": "workspace:*",
    "@ui/elements": "workspace:*",
    "@ui/panes": "workspace:*",
    "source-map-js": "^1.2.1"
  },
  "scripts": {
    "interpreter": "bun --hot run interpreter.ts",
    "typecheck": "tsc --noEmit --pretty false"
  }
}
