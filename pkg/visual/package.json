{
  "name": "@metafor/visual",
  "version": "0.0.1",
  "description": "Immutable complete-snapshot layout strategies and production visual materials.",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "CONTRACT.md",
    "README.md",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./layout": {
      "types": "./src/layout.ts",
      "default": "./src/layout.ts"
    },
    "./layout/centered-nested": {
      "types": "./src/centered-nested.ts",
      "default": "./src/centered-nested.ts"
    },
    "./payload": {
      "types": "./src/payload.ts",
      "default": "./src/payload.ts"
    },
    "./payload/reconcile": {
      "types": "./src/payload-reconcile.ts",
      "default": "./src/payload-reconcile.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --pretty false",
    "playground": "bun playground/server.ts"
  },
  "dependencies": {
    "@metafor/types": "workspace:*",
    "@bulk/types": "workspace:*"
  },
  "devDependencies": {
    "@metafor/engine": "workspace:*"
  }
}
