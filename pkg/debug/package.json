{
  "name": "@metafor/bun-debug",
  "version": "0.0.1",
  "description": "Bun WebKit Inspector sidecar for the MetaFor interpreter.",
  "type": "module",
  "private": true,
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./agent-attach": "./agent-attach.ts"
  },
  "bin": {
    "metafor-interpreter": "./agent-attach.ts"
  },
  "dependencies": {
    "@metafor/components": "workspace:*",
    "@metafor/elements": "workspace:*",
    "source-map-js": "^1.2.1"
  },
  "scripts": {
    "agent": "bun --hot run agent-attach.ts",
    "typecheck": "tsc --noEmit --pretty false"
  }
}
