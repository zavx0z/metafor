{
  "version": 1,
  "selectors": {
    "nodes": {
      "supported": true,
      "package": "@nodes/playground",
      "cwd": "pkg/nodes/playground",
      "command": ["bun", "server.ts"],
      "host": "127.0.0.1",
      "hostEnv": "NODES_PLAYGROUND_HOST",
      "port": 4018,
      "portEnv": "NODES_PLAYGROUND_PORT",
      "origin": "http://127.0.0.1:4018",
      "httpMarker": "<title>Nodes playground</title>",
      "ready": {"kind": "dataset", "name": "nodesPlayground", "value": "ready"},
      "canvas": {"selector": "#nodes-playground-canvas", "capability": "webgpu", "touch": true},
      "routes": {"default": "/"},
      "stateKey": "nodes",
      "logName": "nodes.log"
    },
    "components": {
      "supported": true,
      "package": "@ui/components",
      "cwd": "pkg/ui/components",
      "command": ["bun", "playground/server.ts"],
      "host": "127.0.0.1",
      "port": 4017,
      "portEnv": "COMPONENTS_PLAYGROUND_PORT",
      "origin": "http://127.0.0.1:4017",
      "httpMarker": "<title>@ui/components</title>",
      "ready": {"kind": "canvas", "selector": "#stage-canvas", "minBackingWidth": 301},
      "canvas": {"selector": "#stage-canvas", "capability": "webgpu", "touch": false},
      "routes": {"default": "/button/basic"},
      "stateKey": "components",
      "logName": "components.log"
    },
    "ui-fixture": {
      "supported": true,
      "package": "@ui/playground fixture",
      "cwd": "pkg/ui/playground",
      "command": ["bun", "fixture/server.ts"],
      "host": "127.0.0.1",
      "port": 4192,
      "portEnv": "UI_PLAYGROUND_FIXTURE_PORT",
      "origin": "http://127.0.0.1:4192",
      "httpMarker": "<title>@ui/playground</title>",
      "ready": {"kind": "dataset", "name": "playgroundReady", "value": "ready"},
      "canvas": {"selector": "#playground-canvas", "capability": "webgpu-diagnostic", "touch": false},
      "routes": {"default": "/overview"},
      "stateKey": "ui-fixture",
      "logName": "ui-fixture.log"
    },
    "elements": {
      "supported": true,
      "package": "@ui/elements",
      "cwd": "pkg/ui/elements",
      "command": ["bun", "playground/server.ts"],
      "host": "127.0.0.1",
      "port": 7901,
      "portEnv": "ELEMENTS_PLAYGROUND_PORT",
      "origin": "http://127.0.0.1:7901",
      "httpMarker": "<title>@ui/elements</title>",
      "ready": {"kind": "dataset", "name": "elementsPlayground", "value": "ready"},
      "canvas": {"selector": "#stage-canvas", "capability": "webgpu", "touch": false},
      "routes": {"default": "/div"},
      "stateKey": "elements",
      "logName": "elements.log"
    }
  }
}
