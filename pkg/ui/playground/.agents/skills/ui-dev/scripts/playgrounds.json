{
  "version": 2,
  "selectors": {
    "nodes": {
      "supported": true,
      "package": "@nodes/playground",
      "cwd": "pkg/nodes/playground",
      "command": ["bun", "server.ts"],
      "host": "127.0.0.1",
      "hostEnv": "NODES_PLAYGROUND_HOST",
      "port": 4018,
      "portEnv": "NODES_PLAYGROUND_PORT",
      "origin": "http://127.0.0.1:4018",
      "httpMarker": "<title>Nodes playground</title>",
      "ready": {"kind": "dataset", "name": "nodesPlayground", "value": "ready"},
      "canvas": {"selector": "#nodes-playground-canvas", "capability": "webgpu", "touch": true},
      "routes": {"default": "/"},
      "stateKey": "nodes",
      "logName": "nodes.log"
    },
    "ui": {
      "supported": true,
      "package": "@ui/playground",
      "cwd": "pkg/ui/playground",
      "command": ["bun", "hub/server.ts"],
      "host": "127.0.0.1",
      "hostEnv": "UI_PLAYGROUND_HOST",
      "port": 4017,
      "portEnv": "UI_PLAYGROUND_PORT",
      "origin": "http://127.0.0.1:4017",
      "httpMarker": "<title>UI playground</title>",
      "ready": {"kind": "dataset", "name": "uiPlayground", "value": "ready"},
      "canvas": {"selector": "canvas", "capability": "none", "touch": false},
      "pages": [
        {"mountPath": "/elements", "canvas": {"selector": "#stage-canvas", "capability": "webgpu", "touch": false}},
        {"mountPath": "/components", "canvas": {"selector": "#stage-canvas", "capability": "webgpu", "touch": false}},
        {"mountPath": "/playground", "canvas": {"selector": "#playground-canvas", "capability": "webgpu-diagnostic", "touch": false}},
        {"mountPath": "/hud", "canvas": {"selector": "canvas", "capability": "none", "touch": false}},
        {"mountPath": "/", "canvas": {"selector": "canvas", "capability": "none", "touch": false}}
      ],
      "routes": {"default": "/"},
      "stateKey": "ui",
      "logName": "ui.log"
    }
  }
}
