{
  "name": "@ui/components",
  "version": "0.0.1",
  "description": "MUI-like Vision Pro components built on @ui/elements.",
  "type": "module",
  "private": true,
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./button": "./Button.ts",
    "./field": "./Field.ts",
    "./pane": "./Pane.ts",
    "./checkbox": "./Checkbox.ts",
    "./badge": "./Badge.ts",
    "./typography": "./Typography.ts",
    "./text-field": "./TextField.ts",
    "./number-input": "./NumberInput.ts",
    "./color-input": "./ColorInput.ts",
    "./vector-input": "./VectorInput.ts",
    "./matrix-input": "./MatrixInput.ts",
    "./switcher": "./Switcher.ts",
    "./progress-checkbox": "./ProgressCheckbox.ts",
    "./slider-control": "./SliderControl.ts",
    "./divider": "./Divider.ts",
    "./list": "./List.ts",
    "./table": "./Table.ts"
  },
  "scripts": {
    "playground": "bun playground/server.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:playground": "tsc --noEmit --pretty false --project playground/tsconfig.json"
  },
  "dependencies": {
    "@ui/elements": "workspace:*",
    "@metafor/engine": "workspace:*"
  },
  "devDependencies": {
    "@ui/playground": "workspace:*"
  }
}
